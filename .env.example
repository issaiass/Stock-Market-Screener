# Copy to .env and fill in. Never share or commit .env.

# Resend API key: create one at https://resend.com/api-keys (starts with re_)
RESEND_API_KEY=

# Where the report is sent. With Resend's default test sender (onboarding@resend.dev),
# this must be the email you signed up to Resend with. Comma-separate for several.
EMAIL_TO=

# Optional sender. Default: AI Premarket Analyst <onboarding@resend.dev>
# Use your own verified domain at https://resend.com/domains to send to anyone.
# EMAIL_FROM=AI Premarket Analyst <report@yourdomain.com>

# Telegram: message @BotFather, run /newbot, copy the token. Then message your bot once
# and open https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: channel settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=
